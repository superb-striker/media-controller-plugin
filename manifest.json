{
  "schemaVersion": 1,
  "id": "io.github.superb-striker.media-controller",
  "name": "Media Controller",
  "version": "0.1.0",
  "author": "Nipun Kothari",
  "license": "MIT",
  "description": "Artwork-focused MPRIS media controls with source switching, seeking, and track lists.",
  "kinds": ["service", "bar-widget"],
  "keepLoaded": true,
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Media Controller",
    "description": "Now-playing controls and an artwork preview for MPRIS players",
    "category": "Media",
    "defaultSection": "right",
    "allowMultiple": false,
    "defaults": {
      "width": 180,
      "fontSize": 12
    },
    "schema": [
      { "key": "width", "type": "int", "label": "Title width", "min": 100, "max": 400 },
      { "key": "fontSize", "type": "int", "label": "Font size", "min": 9, "max": 18 }
    ]
  }
}
